# Optional runtime configuration. Copy this file to .env and adjust as needed.

# Maximum accepted PDF size in megabytes.
BANK_STATEMENT_MAX_UPLOAD_MB=15

# Minimum extracted characters per page before OCR is considered.
BANK_STATEMENT_MIN_TEXT_CHARS=40

# OCR rendering resolution.
BANK_STATEMENT_OCR_DPI=300

# Full path to tesseract.exe when Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Classification thresholds. Rules below the first threshold fall back to ML.
BANK_STATEMENT_RULE_THRESHOLD=0.80
BANK_STATEMENT_ML_THRESHOLD=0.55

# Allowed difference between expected and observed running balances.
BANK_STATEMENT_BALANCE_TOLERANCE=0.01
